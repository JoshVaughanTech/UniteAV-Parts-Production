# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets; the template is fine to share
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# local SQLite database
*.db
*.db-journal

# customer BOM data — proprietary (pricing/suppliers). Kept out of git by default;
# place the .xlsx files in sample-boms/ locally to (re)seed. Remove these lines if
# you want them version-controlled in a PRIVATE repo.
/sample-boms/*.xlsx
/sample-boms/*.xls
/sample-boms/*.csv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
